# Copiez ce fichier en .env.local (jamais versionné) et renseignez les valeurs.
# Sur Vercel : Project Settings → Environment Variables (mêmes noms).

# ——— Authentification de l'application (projet Supabase de l'APPLICATION) ———
# Ces deux valeurs sont publiques par nature (préfixe NEXT_PUBLIC_) : la clé publiable
# n'a que les droits de l'utilisateur connecté.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# ——— Workflow n8n AgentMultiUrgence (SERVEUR UNIQUEMENT) ———
# URL de production (…/webhook/…, pas …/webhook-test/…)
N8N_WEBHOOK_URL=https://votre-instance.app.n8n.cloud/webhook/xxxxxxxx
# Valeur attendue dans l'en-tête x-okto-key
N8N_WEBHOOK_SECRET=
# Délai maximal d'attente de la réponse (ms)
N8N_TIMEOUT_MS=60000

# ——— Projet Supabase de l'agent (SERVEUR UNIQUEMENT : la clé de service contourne la RLS) ———
AGENT_SUPABASE_URL=https://cxphmtiicrnrgvhsctgc.supabase.co
AGENT_SUPABASE_SERVICE_KEY=

# Artisan utilisé par AUTH_DEV_BYPASS et par npm run test:agent.
# En usage normal, l'entreprise vient du compte connecté (app_metadata.artisan_id) :
# un compte sans artisan_id n'a pas accès à l'agent.
AGENT_ARTISAN_ID=ART-DEMO-001
# Nombre maximal d'appels à l'agent par utilisateur et par minute
AGENT_RATE_LIMIT_PER_MINUTE=10

# Mode simulé : 1 = réponses fictives, aucun appel à n8n (développement de l'interface)
AGENT_MOCK=0

# Développement local uniquement : 1 = accès sans connexion avec `npm run dev`.
# Ignoré en production (next build / next start / Vercel).
AUTH_DEV_BYPASS=0
